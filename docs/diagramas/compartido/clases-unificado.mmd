    %% ───────── Entidades y enumeraciones ─────────
    class Despliegue {
        +id String
        +numero Integer
        +estado EstadoDespliegue
        +disparador DisparadorDespliegue
        +commitSha String
        +codigoSalida Integer
    }
    class Artefacto {
        +numero Integer
        +imagen String
        +digest String
        +tamanoBytes Integer
        +receta RecetaConstruccion
        +disponible Boolean
    }
    class EstadoDespliegue {
        <<enumeration>>
        encolado
        construyendo
        aprovisionando
        publicando
        saludable
        fallido
        cancelado
        detenido
        revirtiendo
    }
    class EstadoSuscripcion {
        <<enumeration>>
        activa
        por-vencer
        vencida
        suspendida
        cancelada
    }
    class Etapa {
        <<enumeration>>
        recepcion
        construccion
        ejecucion
        enrutamiento
        operacion
    }
    class PlanPipeline {
        <<enumeration>>
        construccion
        reversion
    }

