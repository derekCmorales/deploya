# VPS (M6-02). Copia a .env.vps EN EL SERVIDOR: `cp .env.vps.example .env.vps` y rellena los valores.
# Este archivo no lleva secretos y el real (.env.vps) nunca se sube al repo.

# --- Dominio ---
# Dominio base: la web va en la raíz, la API en api.<dominio> y cada proyecto en <proyecto>.<dominio>.
# Registros A para la raíz y para * hacia la IP del VPS.
DOMINIO_BASE=

# --- Certificado comodín (ADR 0007) ---
# Correo de la cuenta de Let's Encrypt (avisos de vencimiento).
ACME_CORREO=
# Token del proveedor DNS (Cloudflare por defecto) con permiso solo sobre la zona de DOMINIO_BASE.
CF_DNS_API_TOKEN=

# --- Base de datos y cifrado ---
POSTGRES_USER=deploya
POSTGRES_DB=deploya
POSTGRES_PASSWORD=
# 32 bytes exactos. Si se pierde, los valores cifrados de las variables quedan ilegibles.
CLAVE_CIFRADO_VARIABLES=

# --- Cuentas de demo (seed) ---
ADMIN_CORREO=admin@deploya.app
ADMIN_CLAVE=
# Clave de cliente@, vencida@ y suspendida@; en el VPS distinta de ADMIN_CLAVE.
CLIENTE_CLAVE=

# --- Correo (ADR 0001): Resend por SMTP con DOMINIO_BASE verificado (SPF, DKIM y DMARC) ---
# Pasos de la cuenta, el DNS en Cloudflare y la comprobación: docs/correo-produccion.md.
SMTP_HOST=smtp.resend.com
# 465 = TLS directo; si el VPS bloquea el 465, usa 587 (STARTTLS).
SMTP_PORT=465
# Literal «resend»; la contraseña es la clave de API (re_…) con permiso «Sending access».
SMTP_USUARIO=resend
SMTP_CLAVE=
# Debe ser del dominio verificado en Resend.
CORREO_REMITENTE="Deploya <no-responder@dominio-verificado>"
# Brevo (alternativa, solo variables): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_USUARIO y SMTP_CLAVE = login y clave SMTP de Brevo.

# --- Opcional ---
# Sin token, la API pública de GitHub permite 60 peticiones por hora por IP.
GITHUB_TOKEN=

# --- Motor (opcional) ---
# Construcciones en paralelo del worker (ADR 0002). En la EC2 m7i-flex.large (2 vCPU, 8 GB) se queda en 1:
# un `docker build` ya usa las 2 vCPU, y con 2 a la vez las apps de los usuarios pierden CPU (y con
# t3 en unlimited la ráfaga se cobra; ADR 0009). Además no hay candado por proyecto: dos despliegues
# del mismo proyecto podrían construirse a la vez. Sube a 2 solo con 4 vCPU o más.
# TRABAJADOR_CONCURRENCIA=1
