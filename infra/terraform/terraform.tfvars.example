# Copia a terraform.tfvars (no se versiona) y ajusta. Nada de aquí es secreto: los secretos de la
# plataforma van solo en .env.vps del servidor.

dominio             = "deploya.larasolutions.dev"
correos_presupuesto = ["operaciones@example.com"]

# Valores por defecto (descomenta para cambiarlos)
# region               = "us-east-2"
# entorno              = "piloto"
# tipo_instancia       = "m7i-flex.large"   # "t3.large" solo con plan de pago de AWS
# creditos_cpu         = "unlimited"   # solo familia t; "standard" frena la CPU en vez de cobrar ráfagas
# tamano_disco_gb      = 70
# tope_presupuesto_usd = 70          # 5 días ≈ 13 USD; un mes completo ≈ 79 USD (ADR 0009)
# rama                 = "main"
# proteccion_terminacion = true        # recomendado tras la demo

# SSH opcional. Sin cidr_administracion no hay puerto 22 (la vía normal es SSM).
# clave_publica_ssh   = "ssh-ed25519 AAAA... operador@equipo"
# cidr_administracion = "203.0.113.7/32"
