# Copia a .env: `cp .env.example .env`. Nunca subas .env al repo.

# --- docker compose (valores por defecto del entorno de desarrollo) ---
POSTGRES_USER=deploya
POSTGRES_PASSWORD=deploya
POSTGRES_DB=deploya
API_PORT=3001
WEB_PORT=3000
APPS_PORT=80
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API y web fuera de Docker (`pnpm dev:api`, `pnpm dev:web`) ---
# Con compose levantando solo postgres y redis: `docker compose up postgres redis`
DATABASE_URL=postgresql://deploya:deploya@localhost:5432/deploya
REDIS_URL=redis://localhost:6379
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Seed (DB-01) ---
# `docker compose up` lo corre solo (servicio `migracion`); fuera de Docker: `pnpm --filter @deploya/api prisma:seed`.
# ADMIN_CLAVE es obligatoria (sin valor por defecto): compose no arranca sin ella.
# CLIENTE_CLAVE es la de cliente@, vencida@ y suspendida@deploya.app; si queda vacía, usa ADMIN_CLAVE. En el VPS, defínelas distintas.
ADMIN_CORREO=admin@deploya.app
ADMIN_CLAVE=
CLIENTE_CLAVE=

# --- Correo (M10, ADR 0001) ---
# smtp: Mailpit en desarrollo, proveedor externo en el VPS. consola: solo log (pruebas).
# Cambiar de proveedor = cambiar estas variables, no el código.
CORREO_ADAPTADOR=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE="Deploya <no-responder@deploya.localhost>"
# Base de los enlaces de los correos (la web). En compose se arma con WEB_PORT.
URL_WEB=http://localhost:3000

# --- Motor de despliegue (M4 M5 M6, ADR 0002 y 0005) ---
# docker: BullMQ, git, dockerode y Traefik reales (compose). stub: todo en memoria (pruebas y CI sin Docker).
MOTOR_ADAPTADORES=stub
DOMINIO_APPS=localhost
ESQUEMA_APPS=http
TRAEFIK_DINAMICO=/traefik/dinamico
TRAEFIK_CONTENEDOR=deploya-traefik
TRABAJADOR_CONTENEDOR=deploya-worker
TRABAJADOR_CONCURRENCIA=1

# --- Variables de entorno (M3-03) ---
# 32 bytes exactos. Si se pierde, los valores cifrados quedan ilegibles. En el VPS va en el gestor de secretos.
CLAVE_CIFRADO_VARIABLES=deploya-dev-clave-variables-032b

# --- Proyectos (M3) ---
# Opcional: sin token, la API pública de GitHub permite 60 peticiones por hora por IP
# (cada validación de repositorio usa 4). Un token sin permisos basta para subir el límite.
GITHUB_TOKEN=
# Base de la API de GitHub (por defecto https://api.github.com). Solo para Enterprise o un doble local.
GITHUB_API_URL=
# Web: dónde se publican las apps (lo mismo que DOMINIO_APPS y ESQUEMA_APPS del motor).
NEXT_PUBLIC_DOMINIO_APPS=localhost
NEXT_PUBLIC_ESQUEMA_APPS=http
