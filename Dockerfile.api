FROM node:22-alpine AS deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY e2e/package.json e2e/package.json
RUN pnpm install --frozen-lockfile --filter @deploya/api...

FROM deps AS build
COPY apps/api apps/api
RUN pnpm --filter @deploya/api exec prisma generate
RUN pnpm --filter @deploya/api build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY --from=build /repo/node_modules /repo/node_modules
COPY --from=build /repo/apps/api /repo/apps/api
COPY package.json pnpm-workspace.yaml /repo/
WORKDIR /repo/apps/api
EXPOSE 3000
CMD ["node", "dist/main.js"]
