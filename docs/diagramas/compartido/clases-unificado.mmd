    }
    class VerificacionEntornoPuerto {
        <<abstract>>
        +saludable(objetivo ObjetivoSalud) ResultadoSalud
    }
    class EnrutamientoPuerto {
        <<abstract>>
        +publicar(ruta RutaPublica) UrlPublicada
        +retirar(subdominio) void
